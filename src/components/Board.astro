---
/**
 * The hero's right side: the zombie alone, or "My board" with the visitor's pedals and the zombie
 * peeking over its corner. Every editor is rendered as a hidden slot; `src/board/client.ts` shows
 * the ones on the board in board order, and `<html data-board>` (set before paint) picks the state.
 */
import { pedals } from '../pedals';
import PedalMini from './PedalMini.astro';
---

<div class="board">
  <img class="board__zombie" src="/img/zombie.svg" alt="" width="340" height="340" />
  <nav class="board__surface" aria-label="My board">
    <ul class="board__pedals">
      {
        pedals.map((pedal) => (
          <li data-board-slot={pedal.slug} hidden>
            <a href={`/${pedal.slug}/`} title={`Open the ${pedal.name} editor`}>
              <PedalMini pedal={pedal} />
              <span class="visually-hidden">{pedal.name}</span>
              <span class="board__channel" data-board-channel={pedal.storageKey} data-default-channel={pedal.defaultChannel} title="MIDI channel of this editor" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="board__caption">
    <strong>My board</strong>
    <span data-board-count>0 pedals</span>
    <span class="board__midi" data-board-midi hidden><span class="board__dot" aria-hidden="true"></span><span data-board-midi-text></span></span>
    <span>saved in this browser</span>
    <button type="button" class="board__link" data-board-export title="Save your board and its presets as a file">Export</button>
    <button type="button" class="board__link" data-board-import title="Add the pedals and presets of a board file">Import…</button>
  </p>
  <p class="board__hint">
    <button type="button" class="board__link" data-board-import>Have a board file? Import it</button>
  </p>
  <input type="file" accept=".json,application/json" data-board-file hidden aria-label="Board file" />
  <p class="board__status muted" data-board-status></p>
</div>

<style>
  .board {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .board__zombie {
    width: clamp(160px, 24vw, 340px);
    height: auto;
    transform: rotate(-6deg);
    filter: drop-shadow(0 20px 50px rgb(110 200 170 / 0.25));
  }
  .board__surface,
  .board__caption,
  .board__status {
    display: none;
  }
  .board__hint {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
  }
  .board__link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .board__link:hover {
    color: var(--brand);
  }

  /* With pedals on it: the board takes the column, the zombie shrinks into the top right corner */
  :global(html[data-board]) .board {
    width: clamp(280px, 36vw, 420px);
    justify-items: stretch;
    margin-top: 2rem;
  }
  :global(html[data-board]) .board__zombie {
    position: absolute;
    z-index: 1;
    top: -2.4rem;
    right: -1.6rem;
    width: clamp(90px, 9vw, 120px);
    filter: drop-shadow(0 10px 24px rgb(0 0 0 / 0.6));
  }
  :global(html[data-board]) .board__surface,
  :global(html[data-board]) .board__caption,
  :global(html[data-board]) .board__status {
    display: block;
  }
  :global(html[data-board]) .board__hint {
    display: none;
  }

  /* The board itself: rubber surface in an aluminium frame, a velcro strip per row */
  .board__surface {
    --mini: 9px; /* mini pedals: 63 px wide */
    --row: 102px; /* a compact pedal is 63 / 0.62 px tall */
    --row-gap: 14px;
    padding: 16px 18px 18px;
    border: 3px solid #3a3a42;
    border-radius: 10px;
    background: linear-gradient(180deg, #1d1d23, #131317);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05), inset 0 10px 30px rgb(0 0 0 / 0.5), 0 24px 50px -20px rgb(0 0 0 / 0.8);
  }
  .board__pedals {
    display: grid;
    grid-template-columns: repeat(auto-fill, calc(var(--mini) * 7));
    grid-auto-rows: var(--row);
    gap: var(--row-gap) 12px;
    align-items: end;
    justify-content: space-between;
    min-height: calc(3 * var(--row) + 2 * var(--row-gap));
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--mini);
    /* a velcro strip under every row: a faint band with a fine hook texture */
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.03) 0 2px, transparent 2px 4px) 0 0 / 100% 100%,
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(var(--row) - 14px),
        rgb(255 255 255 / 0.035) calc(var(--row) - 14px) var(--row),
        transparent var(--row) calc(var(--row) + var(--row-gap))
      );
    background-blend-mode: overlay;
  }
  .board__pedals li {
    display: contents;
  }
  .board__pedals li[hidden] {
    display: none; /* display: contents would override the hidden attribute */
  }
  .board__pedals a {
    position: relative;
    display: block;
    border-radius: 0.75em;
    transition: transform 0.15s;
  }
  /* the editor's MIDI channel, the one thing that really is per pedal */
  .board__channel {
    position: absolute;
    right: -5px;
    bottom: -6px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--muted);
    font: 600 8px/1.4 var(--font);
    letter-spacing: 0.02em;
  }
  .board__channel:empty {
    display: none;
  }
  .board__midi {
    white-space: nowrap;
  }
  .board__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 50%;
    background: var(--muted);
    vertical-align: 0;
  }
  .board__midi.is-ready .board__dot {
    background: var(--brand);
    box-shadow: 0 0 0 3px rgb(200 241 105 / 0.15);
  }
  .board__pedals a:hover {
    transform: translateY(-3px);
  }
  .board__caption {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .board__caption strong {
    color: var(--text);
  }
  /* a middle dot between the parts, whichever are shown; inline-block keeps it out of the buttons' underline */
  .board__caption > * + *:not([hidden])::before {
    content: '·';
    display: inline-block;
    margin: 0 0.45em 0 0.2em;
    color: var(--muted);
  }
  .board__status {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
  }
  .board__status[role='alert'] {
    color: var(--danger);
  }

  @media (max-width: 700px) {
    .board__zombie {
      width: 120px;
    }
    :global(html[data-board]) .board {
      width: 100%;
      margin-top: 2.5rem;
    }
    :global(html[data-board]) .board__zombie {
      width: 90px;
      right: 0;
    }
  }
</style>
