---
/**
 * A pedal as a small illustration in its own colours: knobs or faders, feet, the name.
 * Everything is in `em`, so the parent's font-size sets the size (1rem → 112 px wide).
 */
import type { PedalDefinition } from '../editor/core/types';

interface Props {
  pedal: PedalDefinition;
}

const { pedal } = Astro.props;
const { theme } = pedal;
const automatone = pedal.face.format === 'automatone';
const style = `--body:${theme.body};--ink:${theme.ink};--knob:${theme.knob};--accent:${theme.accent}`;
---

<div class:list={['mini', { 'mini--automatone': automatone }]} style={style} aria-hidden="true">
  {
    automatone ? (
      <>
        <div class="mini__faders">
          {Array.from({ length: 6 }, (_, i) => (
            <span style={`--pos:${[0.5, 0.65, 0.3, 0.55, 0.7, 0.4][i]}`} />
          ))}
        </div>
        <div class="mini__buttons">
          {Array.from({ length: 5 }, () => <span />)}
        </div>
        <div class="mini__feet mini__feet--automatone"><span /><i /><span /></div>
      </>
    ) : (
      <>
        <div class="mini__knobs">
          {Array.from({ length: 6 }, () => <span />)}
        </div>
        <span class="mini__name">{pedal.name}</span>
        <div class="mini__feet"><span /><span /></div>
      </>
    )
  }
</div>

<style>
  .mini {
    display: grid;
    align-content: space-between;
    gap: 0.5em;
    width: 7em;
    aspect-ratio: 0.62;
    padding: 0.75em 0.625em 0.625em;
    border-radius: 0.75em;
    background: radial-gradient(120% 70% at 20% 0%, rgb(255 255 255 / 0.18), transparent 60%), var(--body);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 0.75em 1.5em -0.625em rgb(0 0 0 / 0.7);
  }
  .mini__knobs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5em;
  }
  .mini__knobs span {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--knob);
    box-shadow: 0 0.125em 0.19em rgb(0 0 0 / 0.3);
  }
  .mini__name {
    overflow: hidden;
    text-align: center;
    white-space: nowrap;
    color: var(--ink);
    font: 700 0.62em/1.1 var(--font-display);
    letter-spacing: 0.12em;
  }
  .mini__feet {
    display: flex;
    justify-content: space-between;
    padding: 0 0.25em;
  }
  .mini__feet span {
    width: 1.375em;
    height: 1.375em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f4f4f4, #8b8b90);
  }

  /* Automatone: wider box with wooden cheeks, six faders, five buttons, a display between the feet */
  .mini--automatone {
    aspect-ratio: 0.88;
    padding: 0.625em 0.5em 0.5em;
    border-radius: 0.3em;
    border-left: 0.44em solid #8a5a2b;
    border-right: 0.44em solid #8a5a2b;
    border-image: linear-gradient(90deg, #a06a33, #6e4420 8%, #9c6630 12%, #7a4b22 88%, #a56f38 92%, #6b411f) 1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.12), transparent 40%), var(--body);
  }
  .mini__faders {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    justify-items: center;
    height: 2.75em;
  }
  .mini__faders span {
    position: relative;
    width: 0.125em;
    height: 100%;
    background: rgb(0 0 0 / 0.55);
  }
  .mini__faders span::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(var(--pos) * 2.125em);
    width: 0.56em;
    height: 0.625em;
    translate: -50% 0;
    border-radius: 0.1em;
    background: var(--knob);
    box-shadow: 0 0.06em 0.125em rgb(0 0 0 / 0.4);
  }
  .mini__buttons {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    justify-items: center;
    padding: 0 0.125em;
  }
  .mini__buttons span {
    width: 0.625em;
    height: 0.625em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fafafa, #9a9b9f);
    box-shadow: 0 0 0 0.1em rgb(0 0 0 / 0.25);
  }
  .mini__feet--automatone {
    align-items: center;
    padding: 0 0.125em;
  }
  .mini__feet--automatone span {
    width: 1em;
    height: 1em;
  }
  .mini__feet--automatone i {
    width: 0.56em;
    height: 0.81em;
    border-radius: 0.1em;
    background: #15090a;
    box-shadow: inset 0 0 0.19em #ff3b30;
  }
</style>
