---
import type { PedalDefinition } from '../editor/core/types';
import BoardToggle from './BoardToggle.astro';
import PedalMini from './PedalMini.astro';

interface Props {
  pedal: PedalDefinition;
}

const { pedal } = Astro.props;
const automatone = pedal.face.format === 'automatone';
const href = `/${pedal.slug}/`;
---

<article class:list={['card', { 'card--automatone': automatone }]} style={`--accent:${pedal.theme.accent}`}>
  <a class="card__link" href={href}>
    <PedalMini pedal={pedal} />
    <div class="card__text">
      <h3>{pedal.name}</h3>
      <p>{pedal.tagline}</p>
    </div>
  </a>
  <a class="card__cta" href={href}>Open editor →</a>
  <div class="card__toggle"><BoardToggle pedal={pedal} icon /></div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 0.6rem 1.25rem;
    padding: 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card__link {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 112px 1fr;
    column-gap: 1.25rem;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .card--automatone .card__link > :global(.mini) {
    align-self: center;
  }
  .card__text h3 {
    margin: 0.2rem 2.4rem 0.4rem 0; /* room for the board toggle in the corner */
    font-size: 1.3rem;
  }
  .card__toggle {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
  }
  .card__text p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .card__cta {
    grid-column: 2;
    align-self: end;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
  }
  .card__cta:hover {
    text-decoration: underline;
  }
</style>
